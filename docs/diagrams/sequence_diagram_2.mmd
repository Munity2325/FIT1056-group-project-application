sequenceDiagram
    actor Staff as Food Bank Staff
    participant UI as Record Donation page<br/>(donation_pages.py)
    participant M as FoodShareManager
    participant D as Donor
    participant B as DonationBatch
    participant A as AuditLogEntry

    loop for each item in the donation
        Staff->>UI: enter item, quantity, unit, expiry, storage, dietary attributes
        UI->>UI: add item to session draft
    end
    Staff->>UI: click "Save donation"
    UI->>M: record_donation(items, user, donor)
    loop for each item
        M->>M: _check_batch(item)
        alt invalid field (name, quantity, storage, attribute)
            M->>M: add to errors
        else expiry date before today
            M->>M: add to rejected [FR-06]
        else valid
            M->>M: add to accepted
        end
    end
    alt errors found
        M-->>UI: {"ok": False, "errors": [...]}
        UI-->>Staff: show error messages
    else no errors
        opt donor chose to give details
            M->>D: Donor(id, name, contact, contact_consent) [FR-05]
        end
        M->>M: donation_counter += 1, ref = "DON-0003"
        loop for each accepted item
            M->>B: DonationBatch(..., donation_ref=ref)
        end
        M->>M: _save_data()
        M-->>UI: {"ok": True, "ref", "batches", "rejected"}
        UI->>M: get_donation_confirmation(ref)
        UI-->>Staff: confirmation with reference and items [FR-07]
        opt an item was rejected as expired
            Staff->>UI: click "Record ... as disposal"
            UI->>M: record_intake_disposal(ref, item, user)
            M->>A: AuditLogEntry(user, "Disposal at intake", reason "Expired")
        end
    end
