sequenceDiagram
    actor Staff as Food Bank Staff
    participant UI as Orders page<br/>(order_pages.py)
    participant M as FoodShareManager
    participant O as Order
    participant H as Household
    participant N as NotificationRecord<br/>(notification log)

    Staff->>UI: open order, choose unavailable item and a substitute
    Note over UI: substitute list only shows batches that suit the household
    Staff->>UI: click "Save substitution"
    UI->>M: record_substitution(order_id, original_batch_id, substitute_batch_id, user)
    M->>M: find_order(order_id)
    M->>O: read status, items
    alt order already packed or later
        M-->>UI: (False, "Substitutions can only be made before the order is packed.")
    else Requested or Approved
        M->>M: find_household(order.household_id)
        M->>M: safety_conflicts / preference_conflicts(substitute, household)
        alt substitute does not suit the household
            M-->>UI: (False, "... does not suit this household's dietary needs.") [FR-18]
        else not enough free stock
            M-->>UI: (False, "Not enough ... in stock.")
        else suitable
            M->>O: substitutions += Substitution(original, substitute, user, time, quantity)
            alt substitute already in the order
                M->>O: add quantity to that line, remove original line
            else substitute not in the order
                M->>O: replace original item with substitute
            end
            M->>M: _notify(order, "Substitution")
            M->>H: read contact_method
            M->>N: NotificationRecord(order_ref, method, message, time) [FR-29]
            Note over N: message has only order ref and pickup time [FR-30]
            M->>M: _save_data()
            M-->>UI: (True, "... The client has been notified.")
        end
    end
