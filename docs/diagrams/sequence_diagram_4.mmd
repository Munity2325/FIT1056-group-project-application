sequenceDiagram
    actor Staff as Food Bank Staff
    participant UI as Client Households page<br/>(household_pages.py)
    participant M as FoodShareManager
    participant H as Household
    participant C as ConsentRecord

    Staff->>UI: fill in name, contact method, household numbers, pickup times
    Note over UI: each field shows why it is asked (FIELD_HELP) [FR-13]
    Staff->>UI: click "Register household"
    alt needs entered but consent box not ticked
        UI-->>Staff: warning: needs can only be saved with consent
    else ok to submit
        UI->>M: register_household(data, user)
        M->>M: _check_household(data)
        alt invalid (no name, no contact, 0 adults, seniors > adults)
            M-->>UI: (None, error message)
        else valid
            M->>H: Household(id, preferred_name, contact, numbers, pickup times) [FR-12]
            M->>C: ConsentRecord(given=False)
            opt client gave consent
                M->>M: give_consent(household_id, safety_needs, preferences, accessibility, user)
                M->>C: given = True, date = today
                M->>H: store safety_needs, preferences, accessibility_needs [FR-14]
            end
            M->>M: _save_data()
            M-->>UI: (household, "Household registered with reference H-0003.")
        end
    end
    opt later, client withdraws consent
        Staff->>UI: click "Client withdraws consent"
        UI->>M: withdraw_consent(household_id, user)
        M->>C: given = False, withdrawn_date = today
        M->>H: clear safety_needs, preferences, accessibility_needs
        M-->>UI: (True, "Consent withdrawn ...")
    end
