sequenceDiagram
    actor V as Volunteer
    participant UI as My Tasks page<br/>(volunteer_pages.py)
    participant M as FoodShareManager
    participant T as Task
    participant O as Order
    participant B as DonationBatch

    V->>UI: open My Tasks
    UI->>M: tasks_for(user)
    M-->>UI: available tasks and this volunteer's tasks [FR-22]
    V->>UI: click "Claim"
    UI->>M: claim_task(task_id, user)
    M->>T: status = "Claimed", history += (user, time) [FR-23]
    UI->>M: picking_list(task_id)
    M->>M: find_order(task.order_id)
    M->>O: read items
    M-->>UI: order ref, bag number, items, shelf, packing notes (no client details) [FR-24]
    V->>UI: click "Start"
    UI->>M: start_task(task_id, user)
    alt task belongs to another volunteer
        M-->>UI: (False, "This task belongs to another volunteer.")
    else own task
        M->>T: status = "In progress"
    end
    V->>UI: click "Mark as packed"
    UI->>M: complete_task(task_id, user)
    loop for each item in the order
        M->>B: check batch.quantity >= item quantity
    end
    alt not enough stock for an item
        M-->>UI: (False, "Not enough ... Please tell a staff member.")
    else all items available
        M->>T: status = "Completed", history += (user, time)
        loop for each item in the order
            M->>B: quantity -= item quantity [FR-09]
        end
        M->>O: status = "Packed"
        M->>M: _save_data()
        M-->>UI: (True, "Task completed. Stock has been updated.")
    end
